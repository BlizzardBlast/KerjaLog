{
  "name": "kerjalog",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": ">=24 <25"
  },
  "expo": {
    "install": {
      "exclude": [
        "@sentry/react-native"
      ]
    }
  },
  "dependencies": {
    "@expo-google-fonts/manrope": "0.4.2",
    "@expo/ui": "~57.0.14",
    "@react-native-async-storage/async-storage": "3.1.1",
    "@sentry/react-native": "^8.23.0",
    "@tanstack/react-form": "1.33.5",
    "expo": "~57.0.18",
    "expo-constants": "~57.0.16",
    "expo-crypto": "~57.0.2",
    "expo-dev-client": "~57.0.16",
    "expo-font": "~57.0.2",
    "expo-linking": "~57.0.8",
    "expo-local-authentication": "~57.0.2",
    "expo-notifications": "~57.0.15",
    "expo-router": "~57.0.17",
    "expo-screen-capture": "~57.0.2",
    "expo-secure-store": "~57.0.2",
    "expo-splash-screen": "~57.0.8",
    "expo-sqlite": "~57.0.2",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.2",
    "expo-system-ui": "~57.0.3",
    "react": "19.2.8",
    "react-native": "0.87.1",
    "react-native-gesture-handler": "~3.2.1",
    "react-native-reanimated": "4.6.0",
    "react-native-safe-area-context": "~5.9.1",
    "react-native-screens": "~4.27.0",
    "react-native-worklets": "0.12.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.5",
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "29.5.14",
    "@types/react": "~19.2.2",
    "@typescript-eslint/parser": "8.65.0",
    "eslint": "10.8.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "expo-doctor": "1.20.1",
    "jest": "~29.7.0",
    "jest-expo": "~57.0.5",
    "react-compiler-healthcheck": "1.0.0",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "lint": "biome lint . && eslint src --max-warnings=0",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "typecheck": "tsc --noEmit",
    "compiler:check": "react-compiler-healthcheck",
    "schema:check": "node scripts/verify-initial-schema.mjs",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:ci": "jest --ci --maxWorkers=1",
    "expo:doctor": "expo-doctor",
    "native:check": "node scripts/native-check.mjs",
    "export:android": "expo export --platform android --output-dir dist/android",
    "export:ios": "expo export --platform ios --output-dir dist/ios",
    "check": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm run compiler:check && pnpm run schema:check && pnpm test:ci && pnpm run expo:doctor && pnpm run native:check && pnpm run export:android && pnpm run export:ios",
    "eas-build-on-error": "sentry-eas-build-on-error",
    "eas-build-on-success": "node scripts/upload-sentry-size-analysis.cjs && sentry-eas-build-on-success"
  },
  "jest": {
    "preset": "jest-expo",
    "clearMocks": true,
    "setupFilesAfterEnv": [
      "<rootDir>/jest-setup.js"
    ],
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/src/$1",
      "^@react-native-async-storage/async-storage$": "@react-native-async-storage/async-storage/jest/async-storage-mock",
      "^expo-notifications$": "<rootDir>/tests/mocks/expo-notifications.ts"
    },
    "collectCoverageFrom": [
      "src/**/*.{ts,tsx}",
      "!src/app/**",
      "!src/**/*.d.ts"
    ]
  },
  "private": true
}
