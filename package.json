{
  "name": "kerjalog",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": ">=24 <25"
  },
  "expo": {
    "install": {
      "exclude": [
        "@sentry/react-native"
      ]
    }
  },
  "dependencies": {
    "@expo-google-fonts/manrope": "0.4.2",
    "@expo/ui": "~58.0.15",
    "@react-native-async-storage/async-storage": "3.1.1",
    "@react-native-community/datetimepicker": "9.2.1",
    "@sentry/react-native": "^8.30.0",
    "@tanstack/react-form": "1.33.5",
    "expo": "~58.0.7",
    "expo-clipboard": "~58.0.3",
    "expo-constants": "58.0.10",
    "expo-crypto": "~58.0.6",
    "expo-dev-client": "~58.0.12",
    "expo-document-picker": "~58.0.4",
    "expo-file-system": "~58.0.8",
    "expo-font": "~58.0.7",
    "expo-linking": "~58.0.11",
    "expo-local-authentication": "~58.0.2",
    "expo-notifications": "~58.1.2",
    "expo-print": "~58.0.5",
    "expo-router": "~58.0.17",
    "expo-screen-capture": "~58.0.5",
    "expo-secure-store": "~58.0.2",
    "expo-sharing": "~58.0.16",
    "expo-splash-screen": "~58.0.7",
    "expo-sqlite": "~58.0.11",
    "expo-status-bar": "~58.0.3",
    "expo-symbols": "~58.0.4",
    "expo-system-ui": "~58.0.5",
    "react": "19.3.0",
    "react-native": "0.87.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.29.0",
    "react-native-worklets": "0.13.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.13",
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "29.5.14",
    "@types/react": "~19.3.0",
    "@typescript-eslint/parser": "8.70.0",
    "eslint": "10.10.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "expo-doctor": "1.20.4",
    "jest": "~29.7.0",
    "jest-expo": "~57.0.5",
    "react-compiler-healthcheck": "1.0.0",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start --dev-client --clear",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "lint": "biome lint . && eslint src --max-warnings=0",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "typecheck": "tsc --noEmit",
    "compiler:check": "react-compiler-healthcheck",
    "schema:check": "node scripts/verify-initial-schema.mjs",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:ci": "jest --ci --maxWorkers=1",
    "expo:doctor": "expo-doctor",
    "native:check": "node scripts/native-check.mjs",
    "export:android": "expo export --platform android --output-dir dist/android",
    "export:ios": "expo export --platform ios --output-dir dist/ios",
    "check": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm run compiler:check && pnpm run schema:check && pnpm test:ci && pnpm run expo:doctor && pnpm run native:check && pnpm run export:android && pnpm run export:ios",
    "eas-build-on-error": "sentry-eas-build-on-error",
    "eas-build-on-success": "node scripts/upload-sentry-size-analysis.cjs && sentry-eas-build-on-success"
  },
  "jest": {
    "preset": "jest-expo",
    "clearMocks": true,
    "setupFilesAfterEnv": [
      "<rootDir>/jest-setup.js"
    ],
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/src/$1",
      "^@react-native-async-storage/async-storage$": "@react-native-async-storage/async-storage/jest/async-storage-mock",
      "^expo-notifications$": "<rootDir>/tests/mocks/expo-notifications.ts"
    },
    "collectCoverageFrom": [
      "src/**/*.{ts,tsx}",
      "!src/app/**",
      "!src/**/*.d.ts"
    ]
  },
  "private": true
}
